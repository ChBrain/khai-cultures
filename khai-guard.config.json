{
  "source": ["packages/**"],
  "test": ["tests/**", ".github/workflows/**", ".husky/**"],
  "exemptRenames": true,
  "driftPolicy": {
    "scopes": ["@chbrain/"]
  },
  "licensePolicy": {
    "packages": ["package.json"],
    "packageLicenses": ["SEE LICENSE IN LICENSE and LICENSE-CODE"]
  },
  "branchScope": {
    "shared": [
      "package.json",
      "packages/*/package.json",
      "package-lock.json",
      "packages/*/CHANGELOG.md",
      ".prettierrc",
      ".gitignore",
      ".npmrc",
      ".nvmrc",
      "LICENSE",
      "LICENSE-CODE",
      "SECURITY.md",
      "packages/khai-cultures/registry.json"
    ],
    "lanes": [
      {
        "pattern": "culture/*",
        "layer": "solution",
        "allow": ["packages/**"]
      },
      {
        "pattern": "group/*",
        "layer": "solution",
        "allow": ["packages/khai-cultures/groups/**"]
      },
      {
        "pattern": "governance/*",
        "layer": "governance",
        "allow": [
          ".github/**",
          ".husky/**",
          "khai-guard.config.json",
          "tests/**",
          "GEMINI.md",
          "CLAUDE.md",
          "REFERENCE.md",
          "management/**",
          "packages/khai-cultures/README.md",
          "packages/khai-cultures/REFERENCES.md",
          "packages/khai-cultures/playwright_instructions.md"
        ]
      },
      {
        "pattern": "changeset-release/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "dependabot/*",
        "layer": "general",
        "allow": ["**/package.json", "**/package-lock.json", ".github/workflows/**"]
      },
      {
        "pattern": "chore/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "fix/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "docs/*",
        "layer": "general",
        "allow": []
      }
    ],
    "riders": [
      {
        "pattern": ".changeset/**",
        "fallback": "governance"
      },
      {
        "pattern": "management/orders/**",
        "fallback": "governance"
      }
    ]
  },
  "changesetPolicy": {
    "countDrivenAdd": ["packages/khai-cultures/cultures/*/play_*.md"]
  }
}
