{
  "source": ["packages/**"],
  "test": ["tests/**/*.test.mjs", ".github/workflows/**", ".husky/**"],
  "exemptRenames": true,
  "gates": [
    {
      "name": "prettier",
      "command": "npm run format:check",
      "fix": "npm run format"
    },
    {
      "name": "conformance",
      "command": "npm test"
    },
    {
      "name": "khai-guard",
      "command": "npx khai-guard",
      "count": "KHAI-Guard OK: (.+)"
    },
    {
      "name": "branch-scope",
      "command": "npx khai-guard branch-check",
      "count": "KHAI-Guard branch-check OK: (.+)"
    },
    {
      "name": "company-coverage",
      "command": "node tests/company_coverage.mjs --gate --base \"$(git merge-base origin/main HEAD)\" --head \"$(git rev-parse HEAD)\"",
      "count": "Company coverage(?: OK)?: (.+)"
    },
    {
      "name": "subnational-conformance",
      "command": "node tests/culture_conformance.mjs --gate --base \"$(git merge-base origin/main HEAD)\" --head \"$(git rev-parse HEAD)\"",
      "count": "Sub-national conformance(?: OK)?: (.+)"
    },
    {
      "name": "persona-wiring",
      "command": "node tests/persona_wiring.mjs --gate --base \"$(git merge-base origin/main HEAD)\" --head \"$(git rev-parse HEAD)\"",
      "count": "Persona wiring(?: OK)?: (.+)"
    },
    {
      "name": "plot-zero",
      "command": "node tests/plot_zero.mjs --gate --base \"$(git merge-base origin/main HEAD)\" --head \"$(git rev-parse HEAD)\"",
      "count": "Plot 0(?: OK)?: (.+)"
    },
    {
      "name": "production-packages",
      "command": "node tests/production_packages.mjs --gate --base \"$(git merge-base origin/main HEAD)\" --head \"$(git rev-parse HEAD)\"",
      "count": "Productions(?: OK)?: (.+)"
    },
    {
      "name": "staging",
      "command": "node tests/staging.mjs",
      "count": "staging: (\\d+ finding\\(s\\))"
    },
    {
      "name": "changeset-check",
      "command": "npx khai-guard changeset-check",
      "fix": "npx changeset add (or npx changeset add --empty for a change that ships no package content)"
    }
  ],
  "ciPolicy": {
    "split": { "khai-tests": ["prettier", "conformance"] }
  },
  "isolationPolicy": {
    "allow": ["position_language_*.md", "position_culture_*.md"]
  },
  "driftPolicy": {
    "scopes": ["@chbrain/"]
  },
  "licensePolicy": {
    "packages": ["package.json"],
    "packageLicenses": ["SEE LICENSE IN LICENSE and LICENSE-CODE"]
  },
  "branchScope": {
    "shared": [
      "package.json",
      "packages/*/package.json",
      "package-lock.json",
      "packages/*/CHANGELOG.md",
      ".prettierrc",
      ".gitignore",
      ".npmrc",
      ".nvmrc",
      "LICENSE",
      "LICENSE-CODE",
      "SECURITY.md",
      "packages/khai-cultures/registry.json"
    ],
    "lanes": [
      {
        "pattern": "governance/*",
        "layer": "governance",
        "allow": [
          ".github/**",
          ".husky/**",
          ".gitattributes",
          "khai-guard.config.json",
          "tests/**",
          "AGENTS.md",
          "GEMINI.md",
          "CLAUDE.md",
          "PERPLEXITY.md",
          "REFERENCE.md",
          "management/**",
          "packages/khai-cultures/README.md",
          "packages/khai-cultures/REFERENCES.md",
          "packages/khai-cultures/playwright_instructions.md"
        ]
      },
      {
        "pattern": "culture/*",
        "layer": "solution",
        "allow": ["packages/**"]
      },
      {
        "pattern": "group/*",
        "layer": "solution",
        "allow": ["packages/khai-cultures/groups/**"]
      },
      {
        "pattern": "changeset-release/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "dependabot/*",
        "layer": "general",
        "allow": ["**/package.json", "**/package-lock.json", ".github/workflows/**"]
      },
      {
        "pattern": "chore/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "fix/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "docs/*",
        "layer": "general",
        "allow": []
      }
    ],
    "riders": [
      {
        "pattern": ".changeset/**",
        "fallback": "governance"
      },
      {
        "pattern": "management/orders/**",
        "fallback": "governance"
      }
    ]
  },
  "changesetPolicy": {
    "countDrivenAdd": [
      "packages/khai-cultures/cultures/*/play_*.md",
      "packages/khai-cultures-*/play_*.md"
    ]
  }
}
