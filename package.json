{
  "name": "@chbrain/khai-cultures",
  "version": "0.290.1",
  "description": "khai cultures: the Cultures content house. Cultures modelled with khai; sources are credited where they are in the public domain.",
  "type": "module",
  "exports": {
    ".": "./package.json",
    "./package.json": "./package.json",
    "./registry.json": "./registry.json"
  },
  "license": "SEE LICENSE IN LICENSE and LICENSE-CODE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChBrain/khai-cultures.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "cultures/**",
    "registry.json",
    "playwright_instructions.md",
    "README.md",
    "LICENSE",
    "LICENSE-CODE"
  ],
  "khai": {
    "engine": "cultures",
    "collection": {
      "dir": "cultures",
      "key": "cultures",
      "anchor": "play_"
    },
    "collections": [
      {
        "dir": "groups",
        "anchor": "play_",
        "references": "cultures"
      }
    ],
    "languages": [
      "am",
      "arn",
      "bar",
      "cu",
      "div",
      "dsb",
      "dzo",
      "fo",
      "gil",
      "gsw",
      "jv",
      "kea",
      "kl",
      "ksh",
      "lzh",
      "mfe",
      "nah",
      "nau",
      "pfl",
      "rif",
      "rm",
      "sxu",
      "tvl",
      "wep",
      "yua"
    ],
    "card": {
      "wire": "The Cultures house: a collection of khai cultures."
    }
  },
  "scripts": {
    "test": "vitest run --test-timeout=30000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "changeset version && node packages/khai-cultures-tongues/build.mjs --write && npx khai-tests registry build && npx prettier --write registry.json packages/khai-cultures-tongues",
    "release": "changeset publish",
    "registry": "npx khai-tests registry build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@chbrain/khai-arch": "^0.1.25",
    "@chbrain/khai-cultures-tongues": "file:./packages/khai-cultures-tongues",
    "@chbrain/khai-guard": "^0.2.1",
    "@chbrain/khai-language": "^0.1.25",
    "@chbrain/khai-pack": "^0.0.3",
    "@chbrain/khai-review": "^0.1.4",
    "@chbrain/khai-tests": "^0.2.8",
    "husky": "^9.1.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@chbrain/khai-engine-language": "^0.1.5",
    "@chbrain/khai-engine-spine": "^0.1.5"
  }
}
